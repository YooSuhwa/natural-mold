# Frontend dev server -> FastAPI backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# Defaults to ag_ui. To build with the previous chat transport:
# NEXT_PUBLIC_CHAT_RUNTIME=langgraph_v3

# Playwright E2E auth account.
# Used by e2e/global-setup.mjs to create a logged-in storageState once per run.
# Keep real shared/staging credentials out of git; override these locally/CI.
E2E_USER_EMAIL=playwright-e2e@moldy.dev
E2E_USER_PASSWORD=correct horse battery staple 42
E2E_USER_NAME=E2E User

# Mock-only E2E mode. Set to 1 only for specs that mock every /api/* request.
# PW_SKIP_BACKEND=1

# Allow text instructions for a running chat (also enable CHAT_STEER_ENABLED on the backend).
NEXT_PUBLIC_CHAT_STEER_ENABLED=false
